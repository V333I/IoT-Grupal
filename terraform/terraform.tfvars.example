# Copia este archivo a "terraform.tfvars" solo si deseas personalizar valores.
# NUNCA subas "terraform.tfvars" ni "*.tfstate" a Git.

aws_region        = "us-east-1"
instance_type     = "t3.small"
ebs_volume_gb     = 20
existing_key_name = "vockey"
allowed_ssh_cidr  = "0.0.0.0/0"

# Si los dejas comentados, Terraform genera secretos aleatorios seguros automáticamente:
# admin_email    = "admin@florasense.local"
# admin_password = "MiPasswordWeb2026!"
# gateway_secret = "mi-secreto-compartido-con-rpi5"
