# ==============================================================================
# Plantilla de Variables de Entorno - Proyecto IoT Grupal (FloraSense Mesh)
# Copia este archivo a ".env" y reemplaza los valores antes de desplegar en AWS.
# NUNCA subas el archivo ".env" real al repositorio.
# ==============================================================================

# --- Base de datos PostgreSQL (local Docker o Amazon RDS) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave-postgres
POSTGRES_DB=smart_irrigation
# Si usas Amazon RDS, descomenta y coloca tu endpoint RDS:
# DATABASE_URL=postgresql://postgres:TU_CLAVE@tu-instancia.rds.amazonaws.com:5432/smart_irrigation?schema=public&sslmode=require&sslaccept=accept_invalid_certs

# --- Backend NestJS ---
PORT=3001
JWT_SECRET=cambia-este-secreto-jwt-largo-y-aleatorio
GATEWAY_SECRET=cambia-este-secreto-compartido-con-rpi5

# Opcional: Claves RSA-2048 en una sola línea (\n) para AWS EC2.
# Si se omiten, el backend genera automáticamente el par en apps/api/keys/ (ignorado por Git).
# AWS_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AWS_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Usuario semilla inicial (se crea solo si no existe) ---
ADMIN_NAME=Administrador IoT
ADMIN_EMAIL=admin@florasense.local
ADMIN_PASSWORD=cambia-esta-clave-admin

# --- Frontend Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Raspberry Pi 5 Gateway ---
# Modos: "tcp" (puente USB Windows), "serial" (RPi5 física /dev/ttyUSB0), "mock" (3 grupos simulados)
RPI_INPUT_MODE=tcp
AWS_API_URL=http://api:3001
GATEWAY_ID=raspberry-pi-5-central
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
SYNC_INTERVAL_SEC=5
